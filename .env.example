# API Keys — 复制此文件为 .env 并填入你的密钥
# cp .env.example .env

# ── 推荐（至少配一个 LLM + Tavily 搜索） ──
DASHSCOPE_API_KEY=sk-xxx           # 阿里百炼（一个 Key 可用 GLM/Kimi/MiniMax 等）
TAVILY_API_KEY=tvly-xxx             # Tavily 搜索 API（Agent 联网搜索依赖）

# ── 可选 Provider ──
ANTHROPIC_API_KEY=sk-xxx            # Anthropic Claude
GOOGLE_API_KEY=sk-xxx               # Google Gemini
OPENAI_API_KEY=sk-xxx               # OpenAI / DeepSeek（共用 OpenAI 兼容格式）
DOUBAO_API_KEY=xxx                  # 字节豆包
XIAOMI_API_KEY=xxx                  # 小米 MiLM
